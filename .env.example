# Which provider decide_next_action()/diagnose_drift() try first: "openrouter"
# or "nvidia". The other provider is still used as an automatic fallback if
# its own API key is configured below - this only picks which one goes
# first. If the chosen provider has no key configured, _build_llm_client
# falls back to whichever provider does have a key, rather than build a
# client guaranteed to fail on first use.
MODEL_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:fre
# If discover skips every action, try a tool-capable model, e.g.:
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Used only as a vision fallback: when the accessibility tree alone hasn't been
# enough for the model to produce a usable locator, the next decision is retried
# with a screenshot attached, routed to this model instead. Must be a
# vision-capable model - OPENROUTER_MODEL above doesn't need to be one.
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free

# Optional second provider (get a key at build.nvidia.com), tried when the
# MODEL_PROVIDER primary fails (rate limit, timeout, ...) - see
# FallbackLLMClient in comp_use/llm_client.py. Leave NVIDIA_API_KEY blank to
# disable the fallback entirely; behavior is then identical to
# OpenRouter-only (regardless of MODEL_PROVIDER, since there's no NVIDIA key
# to use either as primary or fallback).
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

