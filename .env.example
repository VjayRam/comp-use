# Which provider decide_next_action()/diagnose_drift() try first: "nvidia"
# or "openrouter". The other provider is still used as an automatic fallback
# if its own API key is configured below - this only picks which one goes
# first. If the chosen provider has no key configured, _build_llm_client
# falls back to whichever provider does have a key, rather than build a
# client guaranteed to fail on first use.
#
# Defaults to nvidia: OpenRouter's free tier caps the whole ACCOUNT at 50
# model requests per day across every free model, and a single discovery run
# spends 15-20 of them, so a couple of recordings exhaust it and everything
# afterwards fails on HTTP 429 no matter which free model is named.
MODEL_PROVIDER=nvidia

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:fre
# If discover skips every action, try a tool-capable model, e.g.:
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Used only as a vision fallback: when the accessibility tree alone hasn't been
# enough for the model to produce a usable locator, the next decision is retried
# with a screenshot attached, routed to this model instead. Must be a
# vision-capable model - OPENROUTER_MODEL above doesn't need to be one.
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free

# The default provider (get a key at build.nvidia.com). OpenRouter above is
# then the automatic fallback, used when this one fails (rate limit, timeout,
# ...) - see FallbackLLMClient in comp_use/llm_client.py. Leave NVIDIA_API_KEY
# blank to disable this provider entirely, in which case _build_llm_client
# uses OpenRouter regardless of MODEL_PROVIDER.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/muse-glimmer-30b
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# --- MERIDIAN CORE adaptation (capability server / chatbot / dashboard) ---
# See the "MERIDIAN CORE adaptation" section of README.md for full setup.

# Dedicated local Postgres container (docker run --name comp-use-postgres ...,
# see README) - primary store for artifacts/runs/evidence when set. Leave unset
# to fall back to the on-disk artifacts/ + evidence/ layout (fine for local CLI
# use against the original mock app; the capability server/dashboard/chat
# expect this to be set).
COMP_USE_DB_URL=

# "1"/"true"/"yes" runs discovery/replay inside an isolated Docker sandbox
# (headed Chromium + noVNC, comp_use/sandbox.py) instead of a local Playwright
# browser - what lets the dashboard/chat stream a live, human-controllable
# view of the run. Requires Docker Desktop running. Leave unset for a local
# headed/headless Playwright browser on the same machine as the server.
COMP_USE_SANDBOX=

