OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# If discover skips every action, try a tool-capable model, e.g.:
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Used only as a vision fallback: when the accessibility tree alone hasn't been
# enough for the model to produce a usable locator, the next decision is retried
# with a screenshot attached, routed to this model instead. Must be a
# vision-capable model - OPENROUTER_MODEL above doesn't need to be one.
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free

# Optional second provider (get a key at build.nvidia.com), tried ONLY when
# OpenRouter fails (rate limit, timeout, ...) - see FallbackLLMClient in
# comp_use/llm_client.py. Leave NVIDIA_API_KEY blank to disable the fallback
# entirely; behavior is then identical to OpenRouter-only.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

